---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { SITE } from "../consts";
---

<BaseLayout
  title="Roadmap"
  description="Certified Kwechiri milestones, current boundaries, and future roadmap."
>
  <PageIntro
    eyebrow="Project status"
    title="Progress you can audit."
    lead="Kwechiri advances through explicit, owner-approved milestones. Future roadmap entries do not authorize implementation by themselves."
  />

  <section class="section">
    <div class="shell">
      <div class="timeline">
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>Language foundations, modules, and Batch 11A</h2>
          <p>
            Core values, collections, functions, control flow, module
            hardening, the runtime boundary, the professional CLI, and the
            first Standard Library module are closed.
          </p>
        </article>
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>Standard Library Batch 11B</h2>
          <p>
            Grapheme-aware string length and exact raw-string concatenation are
            certified in the official string module. Later Standard Library
            batches remain unauthorized.
          </p>
        </article>
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>Browser playground</h2>
          <p>
            Batches 12A and 12B run single-file Kwechiri programs locally in an
            isolated browser worker, with verified examples, diagnostics,
            accessibility checks, and production security headers. Filesystem
            modules and saved programs remain future work.
          </p>
          <a href="/playground/">Open the playground</a>
        </article>
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>VS Code language support</h2>
          <p>
            The Kwechiri VS Code extension is publicly available with
            highlighting, compile-only diagnostics, and the owner-approved
            brand identity.
          </p>
          <a href={SITE.marketplace}>Install from the VS Code Marketplace</a>
        </article>
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>Kwechiri 1.0</h2>
          <p>
            Milestone 14 finalized terminology, the compatibility policy, npm
            distribution, package ownership, and release procedures. Kwechiri
            1.0.0 is published on npm and tagged <code>v1.0.0</code>.
          </p>
        </article>
        <article class="timeline__item">
          <span class="pill">Certified</span>
          <h2>Standard Library Batch 11C</h2>
          <p>
            Four additive string transformations were released in 1.1.0. Later
            Standard Library batches remain unauthorized.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell prose">
      <h2>Released, still evolving.</h2>
      <p>
        Kwechiri 1.1.0 is the current release. Features described here are not
        guarantees beyond the documented compatibility policy. The CLI is
        published on npm and the project is licensed under MIT.
      </p>
      <div class="callout callout--green">
        <strong>Authoritative roadmap</strong>
        The repository's
        <a href="https://github.com/Jmmadubuike/kwechiri-programming-language/blob/main/docs/roadmap/PROJECT-STATUS.md">
          PROJECT-STATUS.md
        </a>
        is the operational source of truth.
      </div>
    </div>
  </section>
</BaseLayout>
