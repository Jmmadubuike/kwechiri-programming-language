{
  "name": "kwechiri",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "description": "An Igbo-first programming language",
  "homepage": "https://kwechiri.dev",
  "author": "Joseph Mmadubuike",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jmmadubuike/kwechiri-programming-language.git"
  },
  "bugs": {
    "url": "https://github.com/Jmmadubuike/kwechiri-programming-language/issues"
  },
  "keywords": [
    "kwechiri",
    "igbo",
    "programming-language",
    "compiler"
  ],
  "type": "module",
  "bin": {
    "kwechiri": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "assets/brand/kwechiri-logo-main-640.png"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:check": "npm --prefix website run check",
    "website:e2e": "npm --prefix website run test:e2e",
    "vscode:check": "npm --prefix extensions/vscode run check",
    "vscode:package": "npm --prefix extensions/vscode run package",
    "vscode:test": "npm --prefix extensions/vscode run test:integration"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
