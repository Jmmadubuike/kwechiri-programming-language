---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeExample from "../components/CodeExample.astro";
import PageIntro from "../components/PageIntro.astro";
import { examples } from "../lib/examples";
---

<BaseLayout
  title="Examples"
  description="Verified Kwechiri programs and expected output."
>
  <PageIntro
    eyebrow="Executable learning material"
    title="Small programs, real output."
    lead="The sources below come directly from the repository's examples directory. Expected output was verified against the current compiler and runtime."
  />

  <section class="section">
    <div class="shell">
      {examples.map((example, index) => (
        <article>
          <p class="eyebrow">{String(index + 1).padStart(2, "0")} · {example.title}</p>
          <p>{example.description}</p>
          <CodeExample
            label={example.title}
            code={example.source}
            output={example.output}
          />
          {index < examples.length - 1 && <hr />}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
