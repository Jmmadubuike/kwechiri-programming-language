---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeExample from "../../components/CodeExample.astro";
import DocsNav from "../../components/DocsNav.astro";
import PageIntro from "../../components/PageIntro.astro";
import { SITE } from "../../consts";
import { examples } from "../../lib/examples";

const hello = examples.find((example) => example.id === "hello");
if (hello === undefined) throw new Error("The hello example is required.");
---

<BaseLayout
  title="Getting started"
  description="Install Kwechiri from npm or build it from source, then run a verified first program."
>
  <PageIntro
    eyebrow="Documentation"
    title="Install and run Kwechiri."
    lead="Kwechiri is published on npm. Install the CLI with Node.js 20 or newer, or build from source when contributing to the compiler."
  />

  <div class="shell content-layout">
    <DocsNav />
    <article class="prose">
      <h2>Requirements</h2>
      <ul>
        <li>Node.js 20 or newer</li>
        <li>npm</li>
      </ul>

      <h2>Install the CLI</h2>
      <pre tabindex="0"><code>npm install --global kwechiri
kwechiri hello.kwe</code></pre>
      <p>
        Save the program below as <code>hello.kwe</code>, or use any existing
        Kwechiri source file.
      </p>
      <CodeExample label="examples/hello.kwe" code={hello.source} output={hello.output} />

      <h2>Build from source</h2>
      <p>Contributors can clone the repository and run the canonical gate:</p>
      <pre tabindex="0"><code>git clone {SITE.github}.git
cd kwechiri-programming-language
npm ci
npm run check
node dist/cli/index.js examples/hello.kwe</code></pre>
      <p>
        The canonical gate runs linting, strict source and test type checking,
        all tests, and the production build. Review the
        <a href={`${SITE.github}/blob/main/docs/development/testing.md`}>testing guide</a>
        before making changes.
      </p>

      <div class="callout callout--gold">
        <strong>Release status.</strong>
        The CLI, website, and VS Code extension are published independently.
        See the <a href="/roadmap/">roadmap</a> for the verified state of each
        target. The project is licensed under MIT.
      </div>

      <h2>Next reading</h2>
      <p>
        Continue with <a href="/docs/language/">the language overview</a>, inspect
        <a href="/examples/">verified examples</a>, or read the
        <a href={`${SITE.github}/blob/main/docs/language-spec/README.md`}>current normative specification</a>.
      </p>
    </article>
  </div>
</BaseLayout>
